PDFJS_BUILD_PATH=../../packages/foliate-js/node_modules/pdfjs-dist/legacy/build
PDFJS_FONTS_PATH=../../packages/foliate-js/node_modules/pdfjs-dist
PDFJS_STYLE_PATH=../../packages/foliate-js/vendor/pdfjs

# [yohaku] Readest committed its own PostHog, Supabase and Stripe keys here.
# Yohaku ships none of them: there is no account service, telemetry or store.
# The Supabase client still needs a URL to construct, so it points at a
# reserved .invalid host that can never resolve.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=yohaku-offline
