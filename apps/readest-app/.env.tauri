NEXT_PUBLIC_APP_PLATFORM=tauri

DBUS_ID=io.github.chaosnap.yohaku

# [yohaku] Every app build is a Yohaku build (see src/yohaku/build.ts).
NEXT_PUBLIC_YOHAKU_BUILD=true
# No store and no paywall: unlock every Readest premium feature.
NEXT_PUBLIC_SELF_HOSTED=true
# No in-app updater until Yohaku publishes its own signed update feed.
NEXT_PUBLIC_DISABLE_UPDATER=true
# No Readest web API: what still calls it (online metadata search, Readest Voice ...)
# fails at once on a domain that never resolves, so nothing reaches Readest.
NEXT_PUBLIC_API_BASE_URL=https://readest.invalid
NEXT_PUBLIC_NODE_BASE_URL=https://readest.invalid
